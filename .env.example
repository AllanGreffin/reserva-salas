# Copie para .env (que não é versionado) e preencha. O docker compose se recusa a subir sem os dois valores.

# Senha do usuário sa do SQL Server. Exigências do SQL Server: pelo menos 8 caracteres, com maiúsculas,
# minúsculas, números e símbolos. Não use ";" (quebra a connection string).
SQL_SENHA_SA=

# Chave de assinatura do JWT: pelo menos 32 caracteres aleatórios. Para gerar uma:
#   openssl rand -base64 48
JWT_CHAVE=
